# Copy this file to `.env` — which is untracked — and fill in real values.
#
# A real credential must never reach a file git would publish:
# `cargo xtask check --secrets` scans tracked files plus untracked files that are
# not ignored, and fails on a prefixed high-entropy value. Ignored paths are
# skipped, so this local `.env` — which .gitignore covers — is the intended home
# for a live key.
#
# Usage: node --env-file=.env scripts/provider-smoke.mjs

# Text generation endpoint. Any OpenAI-compatible /v1/chat/completions gateway:
#     NAI_LLM_BASE_URL=https://<host>/v1
#     NAI_LLM_API_KEY=<your-key>
#     NAI_LLM_MODEL=<model-id>
NAI_LLM_BASE_URL=
NAI_LLM_API_KEY=
NAI_LLM_MODEL=

# Speech synthesis endpoint. Any OpenAI-compatible /v1/audio/speech gateway.
# The voice identifier must be written the way the endpoint requires it; the
# accepted form is recorded by the smoke run instead of assumed from docs.
NAI_TTS_BASE_URL=
NAI_TTS_API_KEY=
NAI_TTS_MODEL=
NAI_TTS_VOICE=

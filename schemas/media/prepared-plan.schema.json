{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"nai:prepared-plan:v1","title":"PreparedPlan",
 "type":"object","additionalProperties":false,
 "required":["version","scope","input_sha256","asset_identities","total_bytes","total_samples","model_api_calls"],
 "properties":{
  "version":{"const":1},"scope":{"const":"private_session_prepared_plan"},
  "input_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "asset_identities":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
  "total_bytes":{"type":"integer","minimum":1,"maximum":2147483648},
  "total_samples":{"type":"integer","minimum":1,"maximum":480000},
  "model_api_calls":{"type":"integer","minimum":1,"maximum":8}
 }
}

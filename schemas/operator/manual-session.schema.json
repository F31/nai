{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nai.invalid/schemas/manual-session",
  "title": "ManualOperatorSession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "knowledge",
    "prompt",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "endpoint",
        "model",
        "credential_env",
        "price_revision",
        "currency",
        "timeout_ms",
        "max_tokens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "protocol": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "endpoint": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(https://[^\\s]+|http://127\\.0\\.0\\.1:[0-9]+(/[^\\s]*)?)$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "credential_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
        },
        "price_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "snapshot",
        "documents"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "text",
              "local_only"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "local_only": {
                "type": "boolean"
              },
              "valid_from_utc_ms": {
                "type": "integer", "minimum": 0, "maximum": 253402300799999
              },
              "valid_until_utc_ms": {
                "type": "integer", "minimum": 0, "maximum": 253402300799999
              }
            },
            "dependentRequired": {"valid_from_utc_ms":["valid_until_utc_ms"],"valid_until_utc_ms":["valid_from_utc_ms"]}
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "persona",
        "output_contract",
        "revision",
        "segment_chars"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "persona": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "output_contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "segment_chars": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_limit",
        "token_limit",
        "character_limit",
        "cost_limit_minor",
        "request_estimate_minor"
      ],
      "properties": {
        "request_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "token_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "character_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "cost_limit_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "request_estimate_minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "config",
        "assets",
        "licenses",
        "voice_ref",
        "output_id"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "config": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "assets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "voice_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "output_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "provider_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llm",
        "tts"
      ],
      "properties": {
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "failure_threshold",
            "cooldown_ms",
            "providers"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "primary_first",
                "lowest_latency"
              ]
            },
            "failure_threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "cooldown_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            },
            "providers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "protocol",
                  "endpoint",
                  "model",
                  "credential_env",
                  "price_revision",
                  "currency",
                  "timeout_ms",
                  "max_tokens"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "protocol": {
                    "enum": [
                      "openai",
                      "anthropic"
                    ]
                  },
                  "endpoint": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^(https://[^\\s?#@]+|http://127\\.0\\.0\\.1:[0-9]+(/[^\\s?#@]*)?)$"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "credential_env": {
                    "type": "string",
                    "pattern": "^NAI_PROVIDER_[A-Z0-9_]{1,100}$"
                  },
                  "price_revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 30000
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2048
                  },
                  "voice_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "tts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "failure_threshold",
            "cooldown_ms",
            "providers"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "primary_first",
                "lowest_latency"
              ]
            },
            "failure_threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "cooldown_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            },
            "providers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "protocol",
                  "endpoint",
                  "model",
                  "credential_env",
                  "price_revision",
                  "currency",
                  "timeout_ms",
                  "max_tokens",
                  "voice_ref"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "protocol": {
                    "enum": [
                      "openai",
                      "elevenlabs",
                      "siliconflow"
                    ]
                  },
                  "endpoint": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^(https://[^\\s?#@]+|http://127\\.0\\.0\\.1:[0-9]+(/[^\\s?#@]*)?)$"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "credential_env": {
                    "type": "string",
                    "pattern": "^NAI_PROVIDER_[A-Z0-9_]{1,100}$"
                  },
                  "price_revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 30000
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2048
                  },
                  "voice_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nai.invalid/schemas/runtime", "title":"RuntimeConfig",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","edition","deployment","workspace_id","runtime","bindings","session_defaults","scheduler","media","knowledge","budgets","cache","cloud"],
  "properties":{
    "schema_version":{"const":1},"edition":{"enum":["lite","standard","pro"]},"deployment":{"enum":["local","hybrid","distributed"]},"workspace_id":{"type":"string","minLength":1},
    "runtime":{"type":"object","additionalProperties":false,"required":["max_active_sessions","plugin_catalog","control_listener","http_enabled"],"properties":{
      "max_active_sessions":{"type":"integer","minimum":1,"maximum":1024},"plugin_catalog":{"type":"string","minLength":1},"control_listener":{"enum":["named_pipe","unix_socket"]},"http_enabled":{"type":"boolean"}
    }},
    "bindings":{"type":"object","propertyNames":{"pattern":"^[a-z]+(?:[.][a-z]+)+@[1-9][0-9]*$"},"additionalProperties":{"type":"string","minLength":1}},
    "session_defaults":{"type":"object","additionalProperties":false,"required":["mode","allow_auto_without_platform_grant","viewer_memory_enabled"],"properties":{
      "mode":{"enum":["rehearsal","assisted","auto_supervised"]},"allow_auto_without_platform_grant":{"const":false},"viewer_memory_enabled":{"type":"boolean"}
    }},
    "scheduler":{"type":"object","additionalProperties":false,"required":["max_pending_utterances","max_pending_speech_ms","qa_ttl_ms","welcome_ttl_ms","thanks_ttl_ms"],"properties":{
      "max_pending_utterances":{"type":"integer","minimum":1,"maximum":1024},"max_pending_speech_ms":{"type":"integer","minimum":1,"maximum":600000},
      "qa_ttl_ms":{"type":"integer","minimum":1,"maximum":600000},"welcome_ttl_ms":{"type":"integer","minimum":1,"maximum":600000},"thanks_ttl_ms":{"type":"integer","minimum":1,"maximum":600000},
      "max_ingress_events":{"type":"integer","minimum":1,"maximum":4096},"max_state_slots":{"type":"integer","minimum":1,"maximum":256},"max_dedup_entries":{"type":"integer","minimum":1,"maximum":65536},
      "viewer_cooldown_ms":{"type":"integer","minimum":0,"maximum":600000},"fairness_window":{"type":"integer","minimum":2,"maximum":1024},"max_viewer_share_percent":{"type":"integer","minimum":1,"maximum":100},"starvation_ms":{"type":"integer","minimum":1,"maximum":600000}
    }},
    "media":{"type":"object","additionalProperties":false,"required":["lease_renew_ms","lease_expire_ms","output_sample_rate","model_audio_format","startup_buffer_ms","max_buffer_ms"],"properties":{
      "lease_renew_ms":{"type":"integer","minimum":1,"maximum":60000},"lease_expire_ms":{"type":"integer","minimum":1,"maximum":60000},"output_sample_rate":{"enum":[16000,24000,44100,48000]},"model_audio_format":{"const":"from_model_manifest"},"startup_buffer_ms":{"type":"integer","minimum":1,"maximum":60000},"max_buffer_ms":{"type":"integer","minimum":1,"maximum":60000}
    }},
    "knowledge":{"type":"object","additionalProperties":false,"required":["mode","fts_enabled","semantic_enabled","remote_source_refs","index_during_live"],"properties":{
      "mode":{"enum":["local","remote","hybrid"]},"fts_enabled":{"type":"boolean"},"semantic_enabled":{"type":"boolean"},"embedding_profile_ref":{"type":"string","minLength":1},"remote_source_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"index_during_live":{"enum":["disabled","throttled"]}
    },"allOf":[{"if":{"properties":{"semantic_enabled":{"const":true}},"required":["semantic_enabled"]},"then":{"required":["embedding_profile_ref"]}}]},
    "budgets":{"type":"object","additionalProperties":false,"required":["soft_threshold_ratio","hard_stop_new_paid_requests","currency","per_session_limit_minor"],"properties":{
      "soft_threshold_ratio":{"type":"number","exclusiveMinimum":0,"maximum":1},"hard_stop_new_paid_requests":{"const":true},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"per_session_limit_minor":{"type":"string","pattern":"^[1-9][0-9]*$"},
      "global_limit_minor":{"type":"string","pattern":"^[1-9][0-9]*$"},"max_ledger_entries":{"type":"integer","minimum":1,"maximum":100000},
      "global_usage_limits":{"$ref":"#/$defs/counters"},"session_usage_limits":{"$ref":"#/$defs/counters"},"global_concurrent_limits":{"$ref":"#/$defs/counters"},"session_concurrent_limits":{"$ref":"#/$defs/counters"}
    }},
    "cache":{"type":"object","additionalProperties":false,"required":["tts_max_bytes","invalidate_on_fact_change"],"properties":{
      "tts_max_bytes":{"type":"integer","minimum":0,"maximum":1099511627776},"invalidate_on_fact_change":{"const":true}
    }},
    "cloud":{"type":"object","additionalProperties":false,"required":["control_enabled","relay_enabled","render_enabled"],"properties":{
      "control_enabled":{"type":"boolean"},"relay_enabled":{"type":"boolean"},"render_enabled":{"type":"boolean"}
    }}
  },
  "$defs":{"counters":{"type":"object","maxProperties":32,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,63}$"},"additionalProperties":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"}}}
}

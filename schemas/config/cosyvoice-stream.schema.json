{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nai:cosyvoice-stream-config:v1",
  "title": "CosyVoiceStreamConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoint", "reference_file", "prompt_text", "deadline_ms", "max_samples"],
  "properties": {
    "endpoint": {"type":"string", "pattern":"^http://(127\\.0\\.0\\.1|localhost):[0-9]+/inference_zero_shot$", "maxLength":256},
    "reference_file": {"type":"string", "minLength":1, "maxLength":4096},
    "prompt_text": {"type":"string", "minLength":1, "maxLength":2048, "pattern":"<\\|endofprompt\\|>"},
    "deadline_ms": {"type":"integer", "minimum":1, "maximum":45000},
    "max_samples": {"type":"integer", "minimum":1, "maximum":480000},
    "lookahead": {
      "type":"object", "additionalProperties":false,
      "properties": {
        "max_sentence_chars":{"type":"integer","minimum":16,"maximum":256,"default":80},
        "max_sentence_samples":{"type":"integer","minimum":4800,"maximum":240000,"default":144000},
        "max_sentences":{"type":"integer","minimum":1,"maximum":32,"default":16},
        "idle_wait_ms":{"type":"integer","minimum":1,"maximum":10000,"default":4000}
      }
    }
  }
}

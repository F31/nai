{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://nai.invalid/schemas/backup",
  "title":"BackupManifest", "type":"object","additionalProperties":false,
  "required":["schema_version","db_schema_version","created_at_utc_ms","runtime_version","contract_catalog_sha256","sensitive_scope","database","artifacts"],
  "properties":{
    "schema_version":{"const":1},"db_schema_version":{"const":9},"created_at_utc_ms":{"type":"string","pattern":"^[0-9]{1,19}$"},"runtime_version":{"type":"string","minLength":1},"contract_catalog_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sensitive_scope":{"const":"configuration-facts-audit-registered-content;credential-references-only"},
    "database":{"type":"object","additionalProperties":false,"required":["path","sha256","bytes"],"properties":{"path":{"const":"state.sqlite3"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":1,"maximum":268435456}}},
    "artifacts":{"type":"array","maxItems":512,"items":{"type":"object","additionalProperties":false,"required":["path","sha256","bytes"],"properties":{"path":{"type":"string","pattern":"^(knowledge|assets|models)/[a-f0-9]{64}$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":0,"maximum":16777216}}}}
  }
}

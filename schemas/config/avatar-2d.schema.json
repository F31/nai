{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nai.invalid/schemas/avatar-2d",
  "title": "Avatar2DConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pixel_format", "layers", "sample_rate", "max_buffer_samples", "noise_gate", "full_open_rms", "attack_ms", "release_ms"],
  "properties": {
    "schema_version": {"const": 1},
    "pixel_format": {"const": "rgba8"},
    "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 96000},
    "max_buffer_samples": {"type": "integer", "minimum": 1, "maximum": 96000},
    "noise_gate": {"type": "number", "minimum": 0, "maximum": 0.99},
    "full_open_rms": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "attack_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000},
    "release_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000},
    "layers": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset_id", "role", "width", "height", "x", "y"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "role": {"enum": ["base", "mouth_closed", "mouth_open"]},
          "width": {"type": "integer", "minimum": 1, "maximum": 1920},
          "height": {"type": "integer", "minimum": 1, "maximum": 1080},
          "x": {"type": "integer", "minimum": 0, "maximum": 1919},
          "y": {"type": "integer", "minimum": 0, "maximum": 1079}
        }
      }
    }
  }
}

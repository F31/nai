{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelMigrationBackup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backup_id",
    "plan_sha256",
    "credential_keys",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backup_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "credential_keys": {
      "const": "external_keyring_not_exported"
    },
    "files": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 4096,
      "required": [
        "foundation.sqlite",
        "foundation-root.json",
        "initialized.ok"
      ],
      "propertyNames": {
        "pattern": "^(foundation\\.sqlite|foundation-root\\.json|initialized\\.ok|objects/[a-f0-9]{64}|revocations/[a-f0-9]{64}|avatar-packages/[a-f0-9]{64}/(manifest\\.json|config\\.json|LICENSE\\.txt|asset-ids\\.json|asset-[012]\\.rgba|preview\\.png)|avatar-photos/[a-f0-9]{64}\\.jpg|avatar-videos/[a-f0-9]{64}\\.mp4)$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          }
        }
      }
    }
  }
}

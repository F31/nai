{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nai.dev/schemas/foundation/root",
  "title": "FoundationRoot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "owner"
  ],
  "properties": {
    "kind": {
      "const": "nai-foundation-v2"
    },
    "schema_version": {
      "const": 2
    },
    "owner": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}

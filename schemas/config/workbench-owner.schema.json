{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nai.dev/schemas/workbench/owner",
  "title": "WorkbenchOwner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "principal"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "principal": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}

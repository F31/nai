{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nai.dev/schemas/content/preparation-v1",
  "title": "PreparationDraft",
  "oneOf": [
    {
      "$ref": "#/$defs/product"
    },
    {
      "$ref": "#/$defs/host"
    },
    {
      "$ref": "#/$defs/series"
    },
    {
      "$ref": "#/$defs/show"
    },
    {
      "$ref": "#/$defs/manual_run"
    },
    {
      "$ref": "#/$defs/avatar_profile"
    },
    {
      "$ref": "#/$defs/avatar_photo"
    },
    {
      "$ref": "#/$defs/avatar_video"
    }
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value_type",
        "value",
        "source",
        "authority",
        "conditions",
        "valid_from_ms",
        "valid_until_ms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "value_type": {
          "enum": [
            "text",
            "decimal",
            "money",
            "boolean"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "boolean"
            }
          ]
        },
        "currency": {
          "const": "CNY"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "authority": {
          "enum": [
            "owner_confirmed",
            "unverified"
          ]
        },
        "conditions": {
          "type": "string",
          "maxLength": 512
        },
        "valid_from_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "valid_until_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8640000000000000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "boolean"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "decimal"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "required": [
              "unit"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "money"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "required": [
              "currency"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,11})$"
              }
            }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "fact_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "fact_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "uniqueItems": true
        }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "fact_ids",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "fact_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "uniqueItems": true
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "revision",
        "sha256"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "facts",
        "faq",
        "talk_tracks",
        "prohibitions"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "product_draft"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "facts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "faq": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/faq"
          }
        },
        "talk_tracks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "prohibitions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "style",
        "preferences"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "host_draft"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "style": {
          "enum": [
            "professional",
            "friendly",
            "concise"
          ]
        },
        "preferences": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "goal"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "series_draft"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "talk_track_id",
        "mandatory_fact_ids",
        "allow_questions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "talk_track_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "mandatory_fact_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "uniqueItems": true
        },
        "allow_questions": {
          "type": "boolean"
        }
      }
    },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "product",
        "host",
        "series",
        "cues"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "show_draft"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "product": {
          "$ref": "#/$defs/ref"
        },
        "host": {
          "$ref": "#/$defs/ref"
        },
        "series": {
          "$ref": "#/$defs/ref"
        },
        "cues": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/cue"
          }
        }
      }
    },
    "avatar_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "avatar_id",
        "package_version",
        "package_sha256",
        "license_sha256",
        "width",
        "height",
        "selected",
        "revoked"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "avatar_profile_draft"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "avatar_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "package_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1080
        },
        "selected": {
          "type": "boolean"
        },
        "revoked": {
          "type": "boolean"
        }
      }
    },
    "manual_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "show",
        "snapshot",
        "cue_ids",
        "cursor",
        "status",
        "marks",
        "mode",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "manual_run_draft"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "show": {
          "$ref": "#/$defs/ref"
        },
        "snapshot": {
          "$ref": "#/$defs/ref"
        },
        "cue_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          }
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "status": {
          "enum": [
            "open",
            "ended"
          ]
        },
        "mode": {
          "const": "private_manual"
        },
        "evidence": {
          "const": "self_reported"
        },
        "marks": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "cue_id",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "cue_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "avatar_photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "photo_sha256",
        "width",
        "height",
        "revoked"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "avatar_photo_draft"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "photo_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "revoked": {
          "type": "boolean"
        }
      }
    },
    "avatar_video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "name",
        "video_sha256",
        "duration_ms",
        "inspect_version",
        "realistic_drive",
        "revoked"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "avatar_video_draft"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "video_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "inspect_version": {
          "const": "mp4-ftyp-mvhd-v1"
        },
        "realistic_drive": {
          "const": "model_missing"
        },
        "revoked": {
          "type": "boolean"
        }
      }
    }
  }
}

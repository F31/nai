{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nai.dev/schemas/tests/registry.schema.json",
  "title": "V48AcceptanceRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline",
    "work_items",
    "invariants",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "baseline": {
      "const": "docs/digital-host-agent-design-V4.8.md"
    },
    "work_items": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^V48-[0-9]{2}$"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 62,
      "maxItems": 62,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^INV-[0-9]{2}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 164,
      "maxItems": 164,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "expected",
          "work_items",
          "invariants",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^ACC-[A-Z]+-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "work_items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^V48-[0-9]{2}$"
            }
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^INV-[0-9]{2}$"
            }
          },
          "status": {
            "enum": [
              "pending",
              "implemented",
              "tested",
              "blocked",
              "not_applicable",
              "simulated",
              "not_selected"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "result",
                "scope",
                "environment",
                "report",
                "complete"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "prerequisite",
                    "acceptance"
                  ]
                },
                "result": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "simulated"
                  ]
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "environment": {
                  "type": "string",
                  "minLength": 1
                },
                "report": {
                  "type": "string",
                  "minLength": 1
                },
                "complete": {
                  "type": "boolean"
                }
              }
            }
          },
          "condition": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "expression",
              "result",
              "claimed",
              "reason"
            ],
            "properties": {
              "expression": {
                "minLength": 1,
                "type": "string"
              },
              "result": {
                "enum": [
                  "true",
                  "false",
                  "unknown"
                ]
              },
              "claimed": {
                "type": "boolean"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

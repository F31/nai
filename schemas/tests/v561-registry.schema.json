{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nai.local/schemas/tests/v561-registry.schema.json",
  "title": "nai V5.6.1 acceptance registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline", "updated", "policy", "acceptance"],
  "properties": {
    "baseline": {"const": "V5.6.1"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "environments", "evidence_kinds"],
      "properties": {
        "statuses": {"type": "array", "items": {"enum": ["pending", "blocked", "passed", "failed"]}, "minItems": 4, "uniqueItems": true},
        "environments": {"type": "array", "items": {"enum": ["implementation", "simulated", "windows-target", "real-qwen", "real-obs", "real-user"]}, "minItems": 6, "uniqueItems": true},
        "evidence_kinds": {"type": "array", "items": {"enum": ["metrics", "recording", "screenshot", "log", "report", "review"]}, "minItems": 6, "uniqueItems": true}
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "stage", "title", "status", "environment", "command", "expected", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^ACC-V561-(SETUP|TTS|HEAD|PIPE|LIVE|OUT|REL|RES|UX)-\\d{2}$"},
          "group": {"enum": ["SETUP", "TTS", "HEAD", "PIPE", "LIVE", "OUT", "REL", "RES", "UX"]},
          "stage": {"enum": ["M0", "M1", "M2", "M3"]},
          "title": {"type": "string", "minLength": 4},
          "status": {"enum": ["pending", "blocked", "passed", "failed"]},
          "environment": {"enum": ["implementation", "simulated", "windows-target", "real-qwen", "real-obs", "real-user"]},
          "command": {"type": "string", "minLength": 2},
          "expected": {"type": "string", "minLength": 4},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["metrics", "recording", "screenshot", "log", "report", "review"]}
          },
          "blocked_reason": {"type": "string", "minLength": 4},
          "notes": {"type": "string", "minLength": 4}
        }
      }
    }
  }
}

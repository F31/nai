{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nai.invalid/schemas/model", "title":"ModelManifest","type":"object","additionalProperties":false,
  "required":["schema_version","model_id","version","license_ref","graphs","required_graph_ids","preprocess_revision","postprocess_revision","sample_rate","window_samples","hop_samples","lookahead_samples","padding","normalization","frame_mapping","fps_num","fps_den","runtime_matrix","bom_ref","golden_ref"],
  "$defs":{
    "file":{"type":"object","additionalProperties":false,"required":["path","sha256","license_ref"],"properties":{"path":{"type":"string","pattern":"^(?!/|[A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"license_ref":{"type":"string","minLength":1}}},
    "tensor":{"type":"object","additionalProperties":false,"required":["name","dtype","shape"],"properties":{"name":{"type":"string","minLength":1},"dtype":{"enum":["float32","float16","int64","int32","uint8","bool"]},"shape":{"type":"array","minItems":1,"items":{"oneOf":[{"type":"integer","minimum":1},{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]*$"}]}}}}
  },
  "properties":{
    "schema_version":{"const":1},"model_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"license_ref":{"type":"string","minLength":1},
    "graphs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","file","external_weights","inputs","outputs","opset"],"properties":{"id":{"type":"string","minLength":1},"file":{"$ref":"#/$defs/file"},"external_weights":{"type":"array","items":{"$ref":"#/$defs/file"}},"inputs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/tensor"}},"outputs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/tensor"}},"opset":{"type":"integer","minimum":1}}}},
    "required_graph_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"preprocess_revision":{"type":"string","minLength":1},"postprocess_revision":{"type":"string","minLength":1},"sample_rate":{"type":"integer","minimum":1},"window_samples":{"type":"integer","minimum":1},"hop_samples":{"type":"integer","minimum":1},"lookahead_samples":{"type":"integer","minimum":0},"padding":{"type":"string","minLength":1},"normalization":{"type":"string","minLength":1},"frame_mapping":{"type":"string","minLength":1},"fps_num":{"type":"integer","minimum":1},"fps_den":{"type":"integer","minimum":1},
    "runtime_matrix":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["os","arch","ort","ort_crate","ep","precision","driver","cuda","cudnn","certification_ref"],"properties":{"os":{"type":"string","minLength":1},"arch":{"type":"string","minLength":1},"ort":{"type":"string","minLength":1},"ort_crate":{"type":"string","minLength":1},"ep":{"enum":["cpu","cuda","tensorrt","directml"]},"precision":{"enum":["fp32","fp16","int8"]},"driver":{"type":"string","minLength":1},"cuda":{"type":"string","minLength":1},"cudnn":{"type":"string","minLength":1},"certification_ref":{"type":"string","minLength":1}}}},
    "bom_ref":{"type":"string","minLength":1},"golden_ref":{"type":"string","minLength":1}
  }
}

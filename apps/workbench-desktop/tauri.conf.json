{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nai Preparation Workbench",
  "version": "0.1.0",
  "identifier": "cn.nai.workbench.bootstrap",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://127.0.0.1:1420/index.html"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "nai · 备播工作台",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' http://avatarpreview.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}


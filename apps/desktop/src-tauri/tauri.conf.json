{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nai",
  "version": "0.1.0",
  "identifier": "cn.nai.desktop-shell",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --filter @nai/desktop dev",
    "beforeBuildCommand": "pnpm --filter @nai/desktop build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nai · 直播控制台",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/nai-engine", "binaries/nai-output-keeper"]
  }
}
